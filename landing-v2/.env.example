# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de la landing.
#
# Ninguna es obligatoria para que el build pase: todas tienen respaldo o son
# opcionales. Pero DOS de ellas cambian lo que ve un visitante, y por eso estan
# documentadas aqui en vez de descubrirse cuando algo sale mal en produccion.
#
# Copiar a `.env.local` para desarrollo. En Vercel se definen en
# Settings -> Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────


# URL CANONICA DEL SITIO
#
# La usan el sitemap, los metadatos Open Graph y los enlaces canonicos. Sin
# ella el codigo cae al valor oficial que hay en `lib/routes.ts`, asi que NO
# rompe nada — pero si el dominio de produccion cambia y esto no, el sitemap
# publica URLs que no existen y los buscadores las indexan.
#
# Sin barra final.
NEXT_PUBLIC_SITE_URL=https://aigenesis.io


# GOOGLE ANALYTICS 4 — OPCIONAL
#
# Si no se define, el componente de analitica simplemente no monta GA4. Vercel
# Analytics y Speed Insights funcionan aparte y no dependen de esto.
#
# Dejarla vacia es una decision valida, no un olvido.
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# NO se definen aqui, las pone la plataforma:
#
#   CI        GitHub Actions y Vercel la definen solas. El guard de prebuild la
#             usa para saber que no hay stack de desarrollo que detener.
#   VERCEL    Idem, en la maquina de build de Vercel.
#   PORT      La asigna el entorno al servir.
#   NODE_ENV  La pone Next segun el comando.
# ─────────────────────────────────────────────────────────────────────────────
