    "verify:tempo": "node scripts/verify-visual.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:lenguaje": "node scripts/verify-lenguaje.mjs",
    "verify:lenguaje:prueba": "node scripts/probar-guarda-lenguaje.mjs",
    "verify:buscador": "node scripts/probar-buscador.mjs",
    "verify:aula": "node scripts/probar-aula.mjs",
    "subir:video": "node scripts/subir-video.mjs",
    "exportar": "node scripts/exportar.mjs",
    "desplegar": "node scripts/desplegar-ssh.mjs",
    "desplegar:simular": "node scripts/desplegar-ssh.mjs --simular",
    "desplegar:hosting": "node scripts/desplegar-hosting.mjs",
    "desplegar:probar": "node scripts/desplegar-hosting.mjs --probar",
    "verify:i18n:g1": "node scripts/extraer-i18n.mjs --guarda",
    "verify:idioma:g1": "node scripts/probar-idioma-g1.mjs",
    "corpus:progreso": "node scripts/progreso-corpus.mjs"
