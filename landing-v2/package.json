    "dev:repair": "powershell -ExecutionPolicy Bypass -File scripts/repair-next-dev.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "gen:logo-mask": "python scripts/sample-logo-mask.py public/brand/genesis-symbol-512.png lib/trust/genesisLogoMaskPool.generated.ts GENESIS_LOGO 6000",
