{
  "mcpServers": {
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "v0": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.v0.dev",
        "--header",
        "Authorization: Bearer ${env:V0_API_KEY}"
      ],
      "env": {
        "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
      }
    },
    "@21st-dev/magic": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "${env:TWENTY_FIRST_API_KEY}",
        "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
      }
    }
  }
}
