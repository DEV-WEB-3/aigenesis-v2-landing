# AiGenesis V2 — MCP secrets (DO NOT COMMIT)
# Copy this file to: .cursor/mcp.env
# Then set the same variables as Windows User Environment Variables (recommended).
#
# PowerShell (permanent, new terminals only):
#   [System.Environment]::SetEnvironmentVariable("V0_API_KEY", "v0_xxx", "User")
#   [System.Environment]::SetEnvironmentVariable("TWENTY_FIRST_API_KEY", "tf_xxx", "User")
#
# CMD (permanent):
#   setx V0_API_KEY "v0_xxx"
#   setx TWENTY_FIRST_API_KEY "tf_xxx"
#
# After setting variables: fully restart Cursor.
#
# Si v0 / 21st.dev muestran "Error" pero Vercel funciona:
# 1) Confirma que Node está en: C:\Program Files\nodejs\
# 2) Reinicia Cursor por completo (no solo recargar ventana)
# 3) En MCP Settings, pulsa "Show Output" en el server con error

# v0 — https://v0.app → Account Settings → API Keys
V0_API_KEY=v0_REPLACE_ME

# 21st.dev Magic — https://21st.dev/magic/console
TWENTY_FIRST_API_KEY=tf_REPLACE_ME

# Used by @21st-dev/magic MCP (alias of TWENTY_FIRST_API_KEY)
API_KEY=tf_REPLACE_ME
